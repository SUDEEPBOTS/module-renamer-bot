# ========================================================================
#   SUDEEPBOTS MODULE RENAMER BOT - Environment Configuration
# ========================================================================

# Telegram Bot Credentials (Get from @BotFather)
BOT_TOKEN=

# MongoDB Connection String (Optional - falls back to In-Memory DB if omitted)
MONGO_URI=
DATABASE_NAME=renamer_bot

# Primary Bot Owner User ID (Numeric ID from @userinfobot)
OWNER_ID=0

# Additional Sudo User IDs (Comma-separated)
SUDO_USERS=

# Force Subscribe / Must-Join Channel (Without @, e.g. SUDEEPBOTS)
FSUB_CHANNEL=SUDEEPBOTS
FSUB_CHAT_ID=0

# Default GitHub Token for Automated Pushes (Optional)
GITHUB_TOKEN=

# Temporary File Working Directory
WORK_DIR=/tmp/renamer_work
